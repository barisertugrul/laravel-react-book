# ~/apps/uygulama/shared/.env örneği (cPanel, uygulama.ornek.com). İzin: 600.
# GİZLİ değerler BURADA YOK. Siz doldurursunuz:
#   APP_KEY       → kendi bilgisayarınızda: php artisan key:generate --show  (çıktıyı yapıştırın)
#                   İLK kurulumdan ÖNCE dolu olmalı: boşsa oturum şifrelenemez, sağlık denetimi başarısız olur.
#   DB_PASSWORD, MAIL_PASSWORD, BACKUP_ARCHIVE_PASSWORD
# Değerde # $ boşluk tırnak \ varsa TEK TIRNAK içine alın: DB_PASSWORD='p@s#$'
# .env'i değiştirince bir şey yapmanız gerekmez: kur.sh bir sonraki çalışmada config:cache yapar.

APP_NAME=Uygulama
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://uygulama.ornek.com
APP_LOCALE=tr
APP_FALLBACK_LOCALE=tr
APP_FAKER_LOCALE=tr_TR

LOG_CHANNEL=daily
LOG_LEVEL=warning

# cPanel veritabanı ve kullanıcı adları hesap adıyla başlar (ör. hesapadi_uygulama)
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=hesapadi_uygulama
DB_USERNAME=hesapadi_uygulama
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
# HTTPS'e geçince: APP_URL=https://… ve SESSION_SECURE_COOKIE=true
SESSION_SECURE_COOKIE=false

CACHE_STORE=database
# Kuyruk cron'la çalışır: queue:work --stop-when-empty (e-postalar, bildirimler)
QUEUE_CONNECTION=database
# WebSocket sunucusu (Reverb) paylaşımlı hostingte çalışmaz
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# SMTP: cPanel'in sunucu adı çoğu zaman mail.<alan-adı> DEĞİL (bkz. E-posta Hesapları → Bağlan)
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=sunucu-adi.hosting-firmasi.com
MAIL_PORT=465
MAIL_USERNAME=noreply@ornek.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@ornek.com
MAIL_FROM_NAME="${APP_NAME}"

# İzleme
ALERT_EMAIL=yonetici@ornek.com
PULSE_ADMINS=yonetici@ornek.com

# Yedekleme (cron'daki schedule:run çalıştırır; mysqldump için PHP_INI_SCAN_DIR şart, bkz. deploy/README.md)
BACKUP_DISKS=backups
BACKUP_ARCHIVE_PASSWORD=
BACKUP_NOTIFY_EMAIL=yonetici@ornek.com
