# ~/apps/anahtarci/shared/.env örneği (cPanel, lisans.demoistasyonu.com). İzin: 600.
# GİZLİ değerler BURADA YOK. Siz doldurursunuz:
#   APP_KEY       → kendi bilgisayarınızda: php artisan key:generate --show  (çıktıyı yapıştırın)
#                   İLK kurulumdan ÖNCE dolu olmalı: boşsa oturum şifrelenemez, sağlık denetimi başarısız olur.
#   DB_PASSWORD, MAIL_PASSWORD
# LICENSE_SIGNING_KEY sunucuda bin/komut.sh ile üretilir (bkz. komut.sh.ornek).
# Değerde # $ boşluk tırnak \ varsa TEK TIRNAK içine alın: DB_PASSWORD='p@s#$'

APP_NAME=Anahtarcı
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://lisans.demoistasyonu.com
APP_LOCALE=tr
APP_FALLBACK_LOCALE=tr
APP_FAKER_LOCALE=tr_TR

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=demoistasyonu_anahtarci
DB_USERNAME=demoistasyonu_anahtarci
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
# HTTPS'e geçince: APP_URL=https://… ve SESSION_SECURE_COOKIE=true
SESSION_SECURE_COOKIE=false

CACHE_STORE=database
# Kuyruk cron'la çalışır: queue:work --stop-when-empty (lisans üretimi, e-posta, sahte webhook)
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# SMTP: cPanel'in sunucu adı (mail.<alan-adı> DEĞİL; bkz. E-posta Hesapları → Bağlan)
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=cpsrv14.aktasweb.com
MAIL_PORT=465
MAIL_USERNAME=noreply@demoistasyonu.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@demoistasyonu.com
MAIL_FROM_NAME="${APP_NAME}"

# Demo sunucusu: sahte ödeme BİLEREK açık, vitrinde "Demo" şeridi görünür (Bölüm 10)
PAYMENT_PROVIDER=fake
PAYMENT_ALLOW_FAKE=true

# Boş bırakın: komut.sh'teki license:keygen doldurur
LICENSE_SIGNING_KEY=
